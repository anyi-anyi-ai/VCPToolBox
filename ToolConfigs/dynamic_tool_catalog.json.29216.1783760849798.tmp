    "local:ChromeBridge": {
      "originKey": "local:ChromeBridge",
      "pluginName": "ChromeBridge",
      "displayName": "Chrome 浏览器桥接器",
      "description": "混合插件：支持两种浏览器操控模式。模式A - Puppeteer自动化引擎：Agent可主动启动浏览器、像人一样操控（贝塞尔曲线鼠标移动、自然打字、平滑滚动）、获取页面内容、截图等，无需Chrome扩展。模式B - Chrome扩展桥接：通过VCPBridge扩展实现实时页面观察、DOM命令、结构化数据提取、投喂队列等。两种模式可同时使用。",
      "pluginType": "hybridservice",
      "originKind": "local",
      "originId": "local",
      "enabled": true,
      "online": true,
      "available": true,
      "manifestHash": "93fbb90574a10817ac1a94184f269452475a2d23a952adea1c5989053d303dff",
