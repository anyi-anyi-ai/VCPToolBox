# vcp-search-mcp 环境变量模板
# 复制本文件为 config.env（或直接在 MCP 客户端/系统中设置同名环境变量）。
# 切勿把真实密钥提交到版本库；以下全部留空占位。

# ---------- Tavily ----------
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search
TAVILY_DEFAULT_DEPTH=advanced
TAVILY_MAX_RESULTS=10

# ---------- SerpApi ----------
SERP_API_KEY=
SERP_ENDPOINT=https://serpapi.com/search

# ---------- Fathom ----------
FATHOM_API_KEY=
FATHOM_SEARCH_ENDPOINT=https://fathomsearch.xyz
FATHOM_TIMEOUT_MS=30000

# ---------- AnySearch ----------
ANYSEARCH_API_KEY=
ANYSEARCH_SEARCH_ENDPOINT=https://api.anysearch.com/v1/search
ANYSEARCH_MCP_ENDPOINT=https://api.anysearch.com/mcp
ANYSEARCH_TIMEOUT_MS=30000

# ---------- 知乎 OpenAPI ----------
ZHIHU_ACCESS_SECRET=
ZHIHU_OPENAPI_BASE_URL=https://developer.zhihu.com
ZHIHU_ZHIHU_SEARCH_URL=
ZHIHU_GLOBAL_SEARCH_URL=
ZHIHU_SEARCH_TIMEOUT_SECONDS=5

# ---------- Kimi 编码搜索 ----------
KIMI_SEARCH_KEY=
KIMI_SEARCH_URL=https://api.kimi.com/coding/v1/search

# ---------- VSearch 语义搜索（grounding / grok 后端，可选） ----------
VSEARCH_KEY=
VSEARCH_URL=
VSEARCH_MODEL=
GROK_MODEL=

# ---------- 传输层（stdio 默认；可选 sse / streamable-http） ----------
MCP_TRANSPORT=stdio
