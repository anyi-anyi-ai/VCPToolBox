# ========================================================
# RunningHubGen (RunningHub2API 网关 VCP 插件配置文件)
# ========================================================

# RunningHub2API 网关服务地址 (本地 FastAPI 实例)
RUNNINGHUB_GATEWAY_URL=http://127.0.0.1:8788/v1

# 网关鉴权 Key (对应 runninghub2api 的 RH2API_KEY)
RUNNINGHUB_GATEWAY_KEY=sk-rh-adm-master-key

# 本地 runninghub2api 项目根路径 (服务未启动时自动守护拉起)
RUNNINGHUB_PROJECT_PATH=F:\github\01_API_Gateways\runninghub2api

# 本地 Python 执行命令
RUNNINGHUB_PYTHON_CMD=python

# 默认出图保存目录 (相对于 VCP 项目根目录或绝对路径)
SAVE_DIR=H:\VCP\VCPzhangduan\image\runninghub

# 默认工作流模型
DEFAULT_MODEL=qwen_image
