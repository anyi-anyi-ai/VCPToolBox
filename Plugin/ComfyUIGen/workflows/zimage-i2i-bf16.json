{
  "displayName": "Z-Image Turbo bf16 NSFW 图生图",
  "description": "Z-Image Turbo bf16 NSFW版, 图生图",
  "version": "2.0",
  "workflow": {
    "1": {
      "inputs": {
        "pixels": [
          "8",
          0
        ],
        "vae": [
          "20",
          0
        ]
      },
      "class_type": "VAEEncode",
      "_meta": {
        "title": "VAE编码"
      }
    },
    "4": {
      "inputs": {
        "conditioning": [
          "5",
          0
        ]
      },
      "class_type": "ConditioningZeroOut",
      "_meta": {
        "title": "条件零化"
      }
    },
    "5": {
      "inputs": {
        "text": "{{POSITIVE_PROMPT}}",
        "clip": [
          "14",
          0
        ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "CLIP文本编码"
      }
    },
    "8": {
      "inputs": {
        "aspect_ratio": "original",
        "proportional_width": 1,
        "proportional_height": 1,
        "fit": "crop",
        "method": "lanczos",
        "round_to_multiple": "8",
        "scale_to_side": "longest",
        "scale_to_length": [
          "15",
          0
        ],
        "background_color": "#000000",
        "image": [
          "21",
          0
        ]
      },
      "class_type": "LayerUtility: ImageScaleByAspectRatio V2",
      "_meta": {
        "title": "图层工具：按宽高比缩放 V2"
      }
    },
    "10": {
      "inputs": {
        "filename_prefix": "ComfyUI",
        "images": [
          "13",
          0
        ]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "保存图像"
      }
    },
    "11": {
      "inputs": {
        "offload_model": true,
        "offload_cache": true,
        "anything": [
          "12",
          0
        ]
      },
      "class_type": "VRAMCleanup",
      "_meta": {
        "title": "🎈VRAM-Cleanup"
      }
    },
    "12": {
      "inputs": {
        "samples": [
          "16",
          0
        ],
        "vae": [
          "20",
          0
        ]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE解码"
      }
    },
    "13": {
      "inputs": {
        "clean_file_cache": true,
        "clean_processes": true,
        "clean_dlls": true,
        "retry_times": 3,
        "anything": [
          "11",
          0
        ]
      },
      "class_type": "RAMCleanup",
      "_meta": {
        "title": "🎈RAM-Cleanup"
      }
    },
    "14": {
      "inputs": {
        "clip_name": "qwen_3_4b.safetensors",
        "type": "qwen_image",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "加载CLIP"
      }
    },
    "15": {
      "inputs": {
        "value": 1280
      },
      "class_type": "ImpactInt",
      "_meta": {
        "title": "整数"
      }
    },
    "16": {
      "inputs": {
        "seed": "{{SEED}}",
        "steps": "{{STEPS}}",
        "cfg": "{{CFG}}",
        "sampler_name": "{{SAMPLER}}",
        "scheduler": "{{SCHEDULER}}",
        "denoise": "{{DENOISE}}",
        "model": [
          "19",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "4",
          0
        ],
        "latent_image": [
          "1",
          0
        ]
      },
      "class_type": "KSampler",
      "_meta": {
        "title": "K采样器"
      }
    },
    "18": {
      "inputs": {
        "value": 0.6
      },
      "class_type": "PrimitiveFloat",
      "_meta": {
        "title": "浮点数"
      }
    },
    "19": {
      "inputs": {
        "unet_name": "z-image\\z_image_turbo_bf16_nsfw.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "UNet加载器"
      }
    },
    "20": {
      "inputs": {
        "vae_name": "Qwen\\ae.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "加载VAE"
      }
    },
    "21": {
      "inputs": {
        "image": "{{IMAGE}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "加载图像"
      }
    }
  }
}