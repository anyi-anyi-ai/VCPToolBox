# Cloudflare Workers AI 插件配置 (支持单账号与多账号粘性节点池)

# ========================================================
# 1. 主账号 (账号 1) —— 强制使用本机正常网络直连，不走代理
# ========================================================
# 必需：Cloudflare 账号 1 的 Account ID (32位字符串)
CLOUDFLARE_ACCOUNT_ID=

# 必需：Cloudflare 账号 1 的 API Token (具备 Workers AI Read 权限)
CLOUDFLARE_API_TOKEN=

# ========================================================
# 2. 副账号 (账号 2 及往后) —— 自动分流走本地 Docker 粘性节点池代理
# ========================================================
# 格式: AccountId,ApiToken,ProxyUrl,StickyNodeSession
# 例如通过你本地 Docker 中的 Resin (2260) 或代理网关：
CLOUDFLARE_SECONDARY_ACCOUNT_2=account_id_2,token_2,http://127.0.0.1:2260,sticky-session-1
CLOUDFLARE_SECONDARY_ACCOUNT_3=account_id_3,token_3,http://127.0.0.1:2260,sticky-session-2

# 默认全局 Docker 代理地址（当副账号未显式指定 proxy 时回退该地址）
DOCKER_STICKY_PROXY=http://127.0.0.1:2260

# 调度策略：
# - failover (推荐): 优先使用主账号本机直连出图；主账号 10000 神经元用完 (429) 后，自动无缝切换到副账号 2 (粘性节点1) 接管，依此类推。
# - round-robin: 主账号 (本机直连) 与副账号 (粘性节点) 均匀按次轮流出图。
ROTATION_STRATEGY=failover

# ========================================================
# 3. 基础参数
# ========================================================
# 默认生图模型，可选:
# @cf/black-forest-labs/flux-1-schnell (画质最强主力推荐)
# @cf/stabilityai/stable-diffusion-xl-base-1.0
# @cf/bytedance/stable-diffusion-xl-lightning
# @cf/lykon/dreamshaper-8-lcm
DEFAULT_MODEL=@cf/black-forest-labs/flux-1-schnell

# 本地保存目录（留空使用系统默认 image/cloudflare）
SAVE_DIR=
