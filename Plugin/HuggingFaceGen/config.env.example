# Hugging Face Serverless 插件配置 (支持单账号与多账号粘性节点池)

# ========================================================
# 1. 主账号 (账号 1) —— 强制使用本机正常网络直连，不走代理
# ========================================================
# 必需：在 Hugging Face 设置 -> Access Tokens 中创建的免费 Token (以 hf_ 开头，选择 Read 权限)
HUGGINGFACE_API_TOKEN=

# ========================================================
# 2. 副账号 (账号 2 及往后) —— 自动分流走本地 Docker 粘性节点池代理
# ========================================================
# 格式: ApiToken,ProxyUrl,StickyNodeSession
# 例如通过你本地 Docker 中的 Resin (2260) 或代理网关：
HUGGINGFACE_SECONDARY_ACCOUNT_2=hf_token_2,http://127.0.0.1:2260,hf-sticky-node-1
HUGGINGFACE_SECONDARY_ACCOUNT_3=hf_token_3,http://127.0.0.1:2260,hf-sticky-node-2

DOCKER_STICKY_PROXY=http://127.0.0.1:2260

# 调度策略：failover (主账号优先，用完自动切副账号) 或 round-robin (均匀分流)
ROTATION_STRATEGY=failover

# ========================================================
# 3. 基础参数
# ========================================================
DEFAULT_MODEL=black-forest-labs/FLUX.1-schnell
SAVE_DIR=
