# PollinationsGen 插件配置文件
# 无需任何 API Key 即可永久使用！

# 默认生图模型，可选: flux, flux-realism, flux-anime, flux-3d, turbo (默认 flux)
DEFAULT_MODEL=flux

# 默认尺寸 (宽 x 高，最长边建议 <= 2048)
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024

# 本地网络代理（国外直连可留空，如需走本地代理可填 http://127.0.0.1:7890）
HTTP_PROXY=

# 本地存储目录（留空自动使用项目根目录下的 image/pollinations）
SAVE_DIR=
