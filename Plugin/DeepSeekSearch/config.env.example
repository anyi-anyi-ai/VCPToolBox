# ==========================================
# DeepSeek 搜索与抓取插件配置 (DeepSeekSearch)
# ==========================================

# 1. 访问 DeepSeek 官方 API 的凭证
# 支持配置单个 Key，或配置多个 Key（用英文逗号分隔，如: sk-xxx1,sk-xxx2）以实现请求随机轮询
DeepSeekApiKey=sk-YourDeepSeekApiKeyHere

# 2. API 服务器基地址（官方默认为 https://api.deepseek.com）
# 如果您使用了自建的反代网关，可修改为对应的反代基地址
DeepSeekApiBase=https://api.deepseek.com

# 3. 搜索与抓取网络请求超时（毫秒，默认 25000，即 25 秒）
DeepSeekSearchTimeout=25000

# 4. 多关键词（| 分隔）或批量抓取时的并发批次上限（默认 5）
DeepSeekMaxConcurrent=5

# 5. 单个关键词默认返回结果条数（1~50，默认 10）
DeepSeekDefaultCount=10
